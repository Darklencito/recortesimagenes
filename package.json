{
  "name": "cortesmail",
  "private": true,
  "version": "1.0.8",
  "repository": {
    "type": "git",
    "url": "https://github.com/Darklencito/recortesimagenes.git"
  },
  "homepage": "https://github.com/Darklencito/recortesimagenes",
  "description": "Cortador de imágenes y PDF con plantillas, guías precisas y exportación en ZIP.",
  "author": "nodos.pe",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "release": "npm version patch && git push --follow-tags",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --publish never",
    "electron:build:win": "npm run build && electron-builder --win --publish never",
    "electron:build:mac": "npm run build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "pe.nodos.cortesmail",
    "productName": "Herramientas de Diseño Nodos",
    "publish": "github",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "artifactName": "nodos-cortes-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": ["nsis"],
      "icon": "build/icon-1024.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon-1024.png",
      "category": "public.app-category.graphics-design"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Herramientas de Diseño Nodos"
    },
    "dmg": {
      "background": "build/dmg-background.png",
      "icon": "public/icon-512.png",
      "iconSize": 100,
      "contents": [
        { "x": 180, "y": 200, "type": "file" },
        { "x": 430, "y": 200, "type": "link", "path": "/Applications" }
      ],
      "window": { "width": 640, "height": 400 }
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.2",
    "konva": "^10.9.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
